BOT_API_KEY=your_telegram_bot_token
BUY_ME_A_COFFEE_URL=

# Optional Netscape cookie files, relative to the project root or absolute.
# Without these, cookies.txt is used if present; otherwise access is anonymous.
# INSTAGRAM_COOKIES_FILE=instagram-cookies.txt
# YOUTUBE_COOKIES_FILE=cookies.txt

# Enable BOTH only after starting your own telegram-bot-api server with --local.
# TELEGRAM_API_ROOT=http://127.0.0.1:8081
# TELEGRAM_LOCAL_MODE=true

# Credentials for running your own server (from my.telegram.org, not BotFather).
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# BOT_API_PORT=8081
# BOT_API_EXECUTABLE=/absolute/path/to/telegram-bot-api

# Optional executable overrides (paths containing spaces are supported).
# YT_DLP_PATH=/absolute/path/to/yt-dlp
# FFMPEG_LOCATION=/absolute/path/to/ffmpeg-directory
